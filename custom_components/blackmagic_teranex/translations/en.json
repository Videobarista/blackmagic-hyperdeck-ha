          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or hostname of the Teranex. A static address or DHCP reservation is recommended.",
          "port": "TCP port of the Teranex Ethernet Protocol. Leave at 9800 unless you changed it on purpose."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect. Check the IP address and make sure the Teranex is powered on and on the network."
    },
    "abort": {
      "already_configured": "Another configured Teranex already uses this address.",
      "reconfigure_successful": "The address has been updated."
    }
