{
  "config": {
    "step": {
      "user": {
        "title": "Blackmagic Teranex",
        "description": "Enter the IP address of your Teranex. The Ethernet protocol listens on TCP port 9800.",
        "data": {
          "host": "Host",
          "port": "Port"
        },
        "data_description": {
          "host": "IP address or hostname of the Teranex. A static address or DHCP reservation is recommended.",
          "port": "TCP port of the Teranex Ethernet Protocol. Leave at 9800 unless you changed it on purpose."
        }
      },
      "reconfigure": {
        "title": "Change address",
        "description": "Enter the new IP address of this Teranex. The address is only saved once the unit answers on it, and all entities, history and automations are kept.",
